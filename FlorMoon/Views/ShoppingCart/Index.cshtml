@model IEnumerable<FlorMoon.Models.ShoppingCartItem>

@{
    float subtotal = Model?.Sum(i => i.Price * i.Quantity) ?? 0;
    float transport = 0;
}

<main class="container py-5 cart-main-container">
    <h2 class="section-serif mb-4">Shopping Cart</h2>

    <div class="row g-4">
        <div class="col-lg-8">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5 bg-white rounded shadow-sm border">
                    <p class="fs-5 text-muted">Your cart is empty.</p>
                    <a asp-controller="Store" asp-action="Index" class="btn btn-outline-dark mt-2">Go Shopping</a>
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <div class="card mb-3 shadow-sm cart-item-card">
                        <div class="card-body p-3">
                            <div class="row align-items-center">
                                <div class="col-3 col-md-2">
                                    <img src="~/Images/@item.Products?.ImagePath"
                                         class="img-fluid cart-product-img"
                                         alt="@item.Products?.ProductName"
                                         onerror="this.src='/Images/no-image.png';">
                                </div>

                                <div class="col-6 col-md-7">
                                    <h6 class="fw-bold mb-1">@item.Products?.ProductName</h6>
                                    <p class="small text-muted mb-2">@item.Price.ToString("0.00") EURO / buc</p>

                                    <div class="d-flex align-items-center">
                                        <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center">
                                            <input type="hidden" name="itemId" value="@item.ShoppingCartItemID" />
                                            <button type="submit" name="action" value="decrease" class="btn btn-sm btn-outline-secondary quantity-btn">-</button>
                                            <span class="mx-3 fw-bold">@item.Quantity</span>
                                            <button type="submit" name="action" value="increase" class="btn btn-sm btn-outline-secondary quantity-btn">+</button>
                                        </form>
                                    </div>
                                </div>

                                <div class="col-3 col-md-3 text-end">
                                    <p class="fw-bold mb-0">@((item.Price * item.Quantity).ToString("0.00")) EURO</p>
                                    <form asp-action="RemoveFromCart" method="post" class="d-inline">
                                        <input type="hidden" name="itemId" value="@item.ShoppingCartItemID" />
                                        <button type="submit" class="btn btn-link text-danger small p-0 text-decoration-none border-0 bg-transparent">
                                            Remove
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="col-lg-4">
            <div class="shadow-sm checkout-sidebar bg-white p-4 rounded border">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Subtotal:</span>
                    <span class="fw-bold small">@subtotal.ToString("0.00") EURO</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted small">Transport:</span>
                    <span class="text-success fw-bold small">FREE</span>
                </div>

                <hr class="text-muted">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="section-serif mb-0 text-color-primary">Total:</h4>
                    <h4 class="fw-bold mb-0 text-color-total">@((subtotal + transport).ToString("0.00")) EURO</h4>
                </div>

                @if (Model != null && Model.Any())
                {
                    <form asp-controller="ShoppingCart" asp-action="Checkout" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="Address" value="Livrare la adresa din profilul utilizatorului" />

                        <button type="submit" class="btn btn-dark w-100 btn-checkout py-3 fw-bold text-uppercase">
                            Complete the order
                        </button>
                    </form>
                }
                else
                {
                    <button class="btn btn-dark w-100 btn-checkout py-3 fw-bold text-uppercase disabled">
                        Complete the order
                    </button>
                }
            </div>

            @if (Model != null && Model.Any())
            {
                <form asp-action="ClearCart" method="post" class="mt-3 text-center">
                    <button type="submit" class="btn btn-sm btn-link text-muted text-decoration-none">
                        <small>Empty the cart</small>
                    </button>
                </form>
            }
        </div>
    </div>
</main>