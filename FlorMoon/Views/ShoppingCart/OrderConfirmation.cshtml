@model FlorMoon.Models.Order
@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container my-5" style="margin-top: 120px !important;">
    <div class="alert alert-success p-4 mb-5 shadow-sm border-0" style="border-radius: 15px;">
        <div class="d-flex align-items-center mb-3">
            <i class="fas fa-check-circle fa-2x me-3 text-success"></i>
            <h4 class="mb-0" style="font-family: 'Playfair Display', serif;">The order was placed successfully!</h4>
        </div>
        <div class="row mt-3 text-dark">
            <div class="col-md-4">
                <p class="mb-2"><strong>Order ID:</strong> #@Model.OrderID</p>
            </div>
            <div class="col-md-4">
                <p class="mb-2"><strong>Total payment:</strong> @Model.OrderPrice.ToString("0.00") EUR</p>
            </div>
            <div class="col-md-4">
                <p class="mb-2">
                    <strong>Status:</strong>
                    <span class="badge @(Model.Status == "Canceled" ? "bg-danger" : "bg-success")" id="statusBadge">
                        @Model.Status
                    </span>
                </p>
            </div>
        </div>
    </div>

    @if (Model.Status != "Canceled")
    {
        <div class="card border-danger mb-5 shadow-sm" style="border-radius: 15px; border-left: 5px solid #dc3545;">
            <div class="card-body d-flex justify-content-between align-items-center py-4">
                <div>
                    <h5 class="text-danger mb-1 fw-bold">Have you changed your mind?</h5>
                    <p class="text-muted mb-0 small">You can cancel your order now if you made a mistake.</p>
                </div>

                <form asp-controller="ShoppingCart" asp-action="CancelOrder" method="post" onsubmit="return confirm('Are you sure you want to cancel this order?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.OrderID" />
                    <button type="submit" class="btn btn-outline-danger px-4">
                        <i class="fas fa-times-circle me-2"></i> Cancel Order
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-secondary text-center py-4 shadow-sm" style="border-radius: 15px;">
            <i class="fas fa-ban me-2"></i> This order has been <strong>cancelled</strong> and can no longer be processed.
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-5 shadow-sm border-0" style="border-radius: 15px;">
                <div class="card-header bg-dark text-white py-3" style="border-radius: 15px 15px 0 0;">
                    <h5 class="mb-0"><i class="fas fa-shopping-basket me-2"></i>Ordered Products</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Produs</th>
                                    <th>Quantity</th>
                                    <th>Unit price</th>
                                    <th class="text-end pe-4">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OrderItems != null)
                                {
                                    foreach (var item in Model.OrderItems)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold">@item.Products?.ProductName</td>
                                            <td>@item.Quantity</td>
                                            <td>@item.Price.ToString("0.00") EUR</td>
                                            <td class="text-end pe-4">@((item.Quantity * item.Price).ToString("0.00")) EUR</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card mb-4 shadow-sm border-0" style="border-radius: 15px;">
                <div class="card-header bg-light fw-bold py-3">Shipping details</div>
                <div class="card-body">
                    <p class="mb-1"><i class="fas fa-map-marker-alt me-2 text-muted"></i><strong>Addess:</strong></p>
                    <p class="ms-4">@Model.ShippingDetails?.Address</p>
                </div>
            </div>

            <div class="card mb-4 shadow-sm border-0" style="border-radius: 15px;">
                <div class="card-header bg-light fw-bold py-3">Customer Details</div>
                <div class="card-body">
                    <p class="mb-1"><strong>Nume:</strong> @Model.Users?.FirstName @Model.Users?.LastName</p>
                    <p class="mb-0"><strong>Telefon:</strong> @Model.Users?.PhoneNumber</p>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <a href="/" class="btn btn-dark btn-lg px-5 shadow" style="border-radius: 30px;">
            Back to store
        </a>
    </div>
</div>