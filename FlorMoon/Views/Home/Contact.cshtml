@{
    ViewData["Title"] = "Contact";
}

<section class="contact-hero-solid">
    <div class="container text-center text-white">
        <h1 class="contact-main-title">CONTACT US</h1>
        <p class="contact-hero-text">
            Every message is a chance to share beauty and joy. <br>Contact us and let us help you turn flowers into memorable moments
        </p>
    </div>
</section>

<section class="contact-info-section py-5">
    <div class="container">
        <div class="row g-4 text-center">

            <div class="col-md-4">
                <div class="contact-card">
                    <i class="fa-solid fa-house contact-icon-fa"></i>
                    <h4 class="card-title">WORKING HOURS</h4>
                    <p class="card-desc">We’re here to help you bloom every day!</p>
                    <p class="card-detail">Monday-friday 10:00-19:00</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="contact-card">
                    <i class="fa-solid fa-phone contact-icon-fa"></i>
                    <h4 class="card-title">CALL US</h4>
                    <p class="card-desc">Need help choosing the perfect bouquet? Call us at:</p>
                    <p class="card-detail">+40 712 123 123</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="contact-card">
                    <i class="fa-solid fa-envelope contact-icon-fa"></i>
                    <h4 class="card-title">CONTACT US</h4>
                    <p class="card-desc">Have questions or ideas? Drop us an email:</p>
                    <p class="card-detail">flormoon@gmail.com</p>
                </div>
            </div>

        </div>
    </div>
</section>